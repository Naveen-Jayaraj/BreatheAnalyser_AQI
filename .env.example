# Root environment example for quick reference.
# Copy values into the actual service env files used by the app:
# - frontend/.env
# - backend/.env.backend

# ------------------------------
# Frontend (frontend/.env)
# ------------------------------
VITE_API_BASE_URL=/api/v1
VITE_API_KEY=replace_with_backend_api_key

# ------------------------------
# Backend (backend/.env.backend)
# ------------------------------
AQI_BACKEND_HOST=0.0.0.0
AQI_BACKEND_PORT=8080
AQI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AQI_AUTH_REQUIRED=true
AQI_API_KEYS=replace_with_generated_backend_key
DATA_GOV_API_KEY=replace_with_data_gov_api_key
AQI_REDIS_ENABLED=true
AQI_REDIS_URL=redis://localhost:6379/0
