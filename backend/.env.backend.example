AQI_BACKEND_HOST=0.0.0.0
AQI_BACKEND_PORT=8080
AQI_BACKEND_WORKERS=1
AQI_ENV=dev
AQI_DEBUG_MODE=true

# Comma-separated frontend origins allowed by CORS.
AQI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Keep auth enabled in real environments.
AQI_AUTH_REQUIRED=true

# One or more comma-separated API keys.
# Generate with: python -m aqi_pipeline.backend.gen_api_key
AQI_API_KEYS=UR9rV4shHjhgrcqb4BbGkZoohBQ7hbE-jwL6nvJL6mo

# Request + safety guards
AQI_REQUEST_TIMEOUT_SECONDS=12
AQI_STRICT_EXTERNAL_DATA=true
DATA_GOV_API_BASE=https://api.data.gov.in/resource/3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
# Required for live sensor ingestion used by lookup/forecast.
DATA_GOV_API_KEY=replace_with_data_gov_api_key
OPEN_METEO_API_BASE=https://api.open-meteo.com/v1/forecast
OVERPASS_API_BASE=https://overpass-api.de/api/interpreter
AQI_RATE_LIMIT_ENABLED=true
AQI_RATE_LIMIT_PER_MINUTE=120
AQI_RATE_LIMIT_SQLITE_PATH=.cache/rate_limit.sqlite3

# Forecast defaults and limits
AQI_FORECAST_DEFAULT_HOURS=12
AQI_FORECAST_MAX_HOURS=24
AQI_FORECAST_RESOLUTION=8
AQI_FORECAST_GRID_RADIUS_KM=60
AQI_FORECAST_MAX_GRID_CELLS=150
AQI_FORECAST_SENSOR_RADIUS_KM=90
AQI_FORECAST_TIMEOUT_SECONDS=12
AQI_FORECAST_MEMORY_GUARD_VALUES=25000
AQI_FORECAST_LOCK_POLL_ATTEMPTS=6
AQI_FORECAST_LOCK_POLL_INTERVAL_SECONDS=0.15
AQI_MAX_BBOX_CELLS=150
AQI_MAX_BBOX_DEGREES=2.0
AQI_MIN_ZOOM=6
AQI_MAX_ZOOM=16
AQI_BBOX_PARALLEL_WORKERS=4
AQI_ENABLE_CURRENT_CACHE_READ=true

# Weather API settings
AQI_WEATHER_TIMEOUT_SECONDS=12
AQI_WEATHER_RETRIES=1
AQI_WEATHER_AUTO_REFRESH_ENABLED=false
AQI_WEATHER_REFRESH_INTERVAL_SECONDS=3600
AQI_WEATHER_REFRESH_COORDS=28.6139,77.2090;19.0760,72.8777
AQI_H3_PROPERTIES_PATH=coverage/h3_properties.pkl

# Redis cache (falls back to local SQLite cache if unavailable)
AQI_REDIS_ENABLED=true
AQI_REDIS_URL=redis://localhost:6379/0
AQI_REDIS_TTL_CURRENT_SECONDS=900
AQI_REDIS_TTL_FORECAST_SECONDS=3600
AQI_REDIS_TTL_WEATHER_SECONDS=2700
AQI_CACHE_LOCK_TTL_SECONDS=45
AQI_LOCAL_CACHE_SQLITE_PATH=.cache/local_cache.sqlite3
